# Copy this file to .env and fill in real values. .env must never be committed.
#
# IMPORTANT for an existing install: MySQL, MongoDB and Postgres set their passwords only the
# FIRST time their data volume is created. Put your CURRENT passwords here, or the containers
# will start but nothing will be able to log in.

MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MONGO_ROOT_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

AIRFLOW_ADMIN_PASSWORD=change-me
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

ANTHROPIC_API_KEY=
MANDATE_MODEL=claude-haiku-5-5
